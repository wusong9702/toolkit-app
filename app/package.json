{
  "name": "toolkit-app",
  "version": "0.1.0",
  "private": true,
  "description": "跨平台工具箱应用 - H5 先行，可打包 iOS / Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "android:init": "npx cap add android",
    "ios:init": "npx cap add ios",
    "android:build": "npm run cap:sync && cd android && gradlew assembleRelease && cd ..",
    "android:bundle": "npm run cap:sync && cd android && gradlew bundleRelease && cd .."
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "capacitor-secure-storage-plugin": "^0.12.0",
    "pinia": "^2.3.0",
    "pinyin-pro": "^3.29.3",
    "sortablejs": "^1.15.7",
    "vant": "^4.9.15",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^2.2.0"
  }
}
